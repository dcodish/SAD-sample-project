<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>

    <!-- ============================================================
         אפשרות 1 (ברירת מחדל) - SQL Server מקומי
         שם ה-Instance תלוי בהתקנה שלכם. ברירת המחדל היא SQLEXPRESS.
         ============================================================ -->
    <add name="SadDb"
         connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=SAD_0;Integrated Security=True;TrustServerCertificate=True"
         providerName="Microsoft.Data.SqlClient" />

    <!-- ============================================================
         אפשרות 2 - Azure SQL Database (בסיס הנתונים המשותף של הקבוצה)
         כדי לעבור אליה: הפכו את השורות של אפשרות 1 להערה, בטלו את ההערה
         מהשורות שלמטה, ומלאו את ארבעת הערכים שקיבלתם מיוצר בסיס הנתונים.

         שימו לב: ב-Azure אין Integrated Security - מזדהים בשם משתמש וסיסמה.
         אזהרה: קובץ עם סיסמה אמיתית לא עולה ל-git. הוסיפו אותו ל-.gitignore.
         ============================================================ -->
    <!--
    <add name="SadDb"
         connectionString="Server=tcp:&lt;servername&gt;.database.windows.net,1433;Initial Catalog=&lt;database&gt;;User ID=&lt;username&gt;;Password=&lt;password&gt;;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
         providerName="Microsoft.Data.SqlClient" />
    -->

  </connectionStrings>
</configuration>
